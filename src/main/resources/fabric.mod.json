{
	"schemaVersion": 1,
	"id": "chest-utils",
	"version": "${version}",
	"name": "Chest Utils",
	"description": "Dyed chests, and sort, dump, top-up and empty buttons on every chest",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/chest-utils"
	},
	"license": "MIT",
	"icon": "assets/chest-utils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.chest_utils.Main"
		]
	},
	"suggests": {
    "block-tip": "*"
  },
  "depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.13.0"
	},
	"mixins": [
		"chest-utils.mixins.json"
	],
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.donate": "https://github.com/sponsors/fatlard1993"
			}
		}
	}
}
