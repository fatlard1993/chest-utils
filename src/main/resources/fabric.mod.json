{
	"schemaVersion": 1,
	"id": "chest-utils",
	"version": "${version}",
	"name": "Chest Utils",
	"description": "Dyed chests, and the buttons a chest should always have had: sort, dump, top up, empty. Plus drag and scroll to move stacks without picking them up.",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/chest-utils"
	},
	"license": "MIT",
	"icon": "assets/chest-utils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.chest_utils.Main"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.1",
		"fabric-api": "*",
		"minecraft": ">=26.2",
		"java": ">=25",
		"pandorical": ">=1.7.0"
	},
	"mixins": [
		"chest-utils.mixins.json"
	]
}
